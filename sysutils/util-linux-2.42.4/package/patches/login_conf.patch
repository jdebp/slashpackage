+/*
+ *  login_conf.c -- process login.conf(5) files using login_cap(3)
+ *
+ *  Copyright 2026 Jonathan de Boyne Pollard
+ *  This file is based on prior work by Jonathan de Boyne Pollard.
+ *
+ *  This file is free software; you can redistribute it and/or
+ *  modify it under the terms of the GNU Library General Public
+ *  License version 2 as published by the Free Software Foundation.
+ */
+
+#include <errno.h>
+#include <pwd.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdbool.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "c.h"
+#include "env.h"
+#include "xalloc.h"
+#include "login_cap.h"
+#include "login_conf.h"
+
+struct login_cap_t *
+loginconf_getsystem(
+	const struct passwd * pwd
+) {
+	return login_getsystemclass(pwd);
+}
+
+struct login_cap_t *
+loginconf_getuser(
+	const struct passwd * pwd
+) {
+	return login_getuserclass(pwd);
+}
+
+void
+loginconf_close(
+	struct login_cap_t * cap
+) {
+	login_close(cap);
+}
+
+static inline
+int
+append_char_to_string(
+	char ** ps,
+	char c
+) {
+	if (!ps)
+		return -EINVAL;
+	size_t l = strlen(*ps);
+	char * tmp = realloc(*ps, l + 2U);
+	if (!tmp)
+		return -ENOMEM;
+	*ps = tmp;
+	tmp[l++] = c;
+	tmp[l++] = '\0';
+	return 0;
+}
+
+static
+bool
+may_overwrite (
+	const char * var
+) {
+	return
+		/* These may have been declared safe and inherited; so we do not overwrite them. */
+		0 != strcmp(var, "TERM") &&
+		0 != strcmp(var, "COLORTERM")
+		;
+}
+
+static
+void
+vec_set_if (
+	const char * var,
+	bool cond,
+	const char * val
+) {
+	bool overwrite = may_overwrite(var);
+	if (cond)
+		xsetenv(var, val, overwrite);
+	else {
+		if (overwrite) unsetenv(var);
+	}
+}
+
+static
+void
+split_vec_and_set (
+	const struct passwd * pwd,
+	const char * vec
+) {
+	if (!vec) return;
+	char * var = strdup(""), * val = strdup("");
+	char ** cur = &var;
+	for (;;) {
+		char c = *vec++;
+		if (!c) {
+end:
+			vec_set_if(var, &var != cur, val);
+			break;
+		} else
+		if ('\\' == c) {
+			c = *vec++;
+			if (!c) goto end;
+			append_char_to_string(cur, c);
+		} else
+		if ('~' == c) {
+			if (pwd->pw_dir) {
+				xstrappend(cur, pwd->pw_dir);
+				if (*vec && '/' != *vec && *pwd->pw_dir)
+					append_char_to_string(cur, '/');
+			}
+		} else
+		if ('$' == c) {
+			if (pwd->pw_name)
+				xstrappend(cur, pwd->pw_name);
+		} else
+		if (',' == c) {
+			vec_set_if(var, &var != cur, val);
+			cur = &var;
+			*var = *val = '\0';
+		} else
+		if ('=' == c && &var == cur) {
+			cur = &val;
+		} else
+			append_char_to_string(cur, c);
+	}
+	free(val);
+	free(var);
+}
+
+static
+void
+set_vec (
+	const char * cap,
+	const struct passwd * pwd,
+	struct login_cap_t * lc_system,
+	struct login_cap_t * lc_user
+) {
+	const char * val = NULL;
+	val = login_getcapstr(lc_system, cap, NULL, NULL);
+	if (val)
+		split_vec_and_set (pwd, val);
+	val = login_getcapstr(lc_user, cap, NULL, NULL);
+	if (val)
+		split_vec_and_set (pwd, val);
+}
+
+static
+void
+expand_and_set (
+	const struct passwd * pwd,
+	const char * var,
+	const char * val,
+	bool is_path
+) {
+	bool overwrite = may_overwrite(var);
+	if (!val) {
+		if (overwrite) unsetenv(var);
+	} else {
+		char * s = strdup("");
+		for (char c = *val++; c; c = *val++) {
+			if ('\\' == c) {
+				c = *val++;
+				if (!c) break;
+				append_char_to_string(&s, c);
+			} else
+			if ('~' == c) {
+				if (pwd->pw_dir) {
+					xstrappend(&s, pwd->pw_dir);
+					if (*val && '/' != *val && *pwd->pw_dir)
+						append_char_to_string(&s, '/');
+				}
+			} else
+			if ('$' == c) {
+				if (pwd->pw_name)
+					xstrappend(&s, pwd->pw_name);
+			} else
+			if (is_path && isspace(c)) {
+				while (*val && isspace(*val)) ++val;
+				append_char_to_string(&s, ':');
+			} else
+				append_char_to_string(&s, c);
+		}
+		xsetenv(var, s, overwrite);
+		free(s);
+	}
+}
+
+static
+void
+default_str (
+	const char * var,
+	const char * cap,
+	const struct passwd * pwd,
+	struct login_cap_t * lc_system,
+	struct login_cap_t * lc_user,
+	const char * def
+) {
+	const char * val = login_getcapstr(lc_user, cap, def, NULL);
+	if (!val || def == val)
+		val = login_getcapstr(lc_system, cap, def, def);
+	expand_and_set(pwd, var, val, false);
+}
+
+static
+void
+default_pathstr (
+	const char * var,
+	const char * cap,
+	const struct passwd * pwd,
+	struct login_cap_t * lc_system,
+	struct login_cap_t * lc_user,
+	const char * def
+) {
+	const char * val = login_getcapstr(lc_user, cap, def, NULL);
+	if (!val || def == val)
+		val = login_getcapstr(lc_system, cap, def, def);
+	expand_and_set(pwd, var, val, true);
+}
+
+int
+loginconf_get_hushlogin(
+	const struct login_cap_t * lc_system,
+	const struct login_cap_t * lc_user
+) {
+	int r = login_getcapbool(lc_user, "hushlogin", -1);
+	if (0 > r)
+		r = login_getcapbool(lc_system, "hushlogin", -1);
+	return r;
+}
+
+void
+loginconf_set_environ(
+	const struct passwd * pwd,
+	struct login_cap_t * lc_system,
+	struct login_cap_t * lc_user
+) {
+#if BUILD_PG
+	const char * pager = "pg";
+#else
+	const char * pager = "more";
+#endif
+	const char * manpager = pager;
+	const char * www_browser = "www-browser";
+	const char * xml_viewer = NULL;
+
+	// setenv in login.conf can be superseded by all of the rest of the settings.
+	set_vec("setenv", pwd, lc_system, lc_user);
+	// https://sourceware.org/glibc/wiki/Proposals/C.UTF-8
+	default_str("LANG", "lang", pwd, lc_system, lc_user, "C.UTF-8");
+	default_str("MM_CHARSET", "charset", pwd, lc_system, lc_user, "UTF-8");
+	default_pathstr("PATH", "path", pwd, lc_system, lc_user, NULL /* Defaulting this is done by login.defs(5). */);
+	default_pathstr("MANPATH", "manpath", pwd, lc_system, lc_user, NULL);
+	default_pathstr("TERMPATH", "termpath", pwd, lc_system, lc_user, NULL);
+	default_pathstr("TERMINFO_DIRS", "terminfopath", pwd, lc_system, lc_user, NULL);
+	default_str("TERM", "term", pwd, lc_system, lc_user, "ansi" /* Hurrah!  We have finally reached 1976. Progress! */);
+	default_str("COLORTERM", "colorterm", pwd, lc_system, lc_user, NULL);
+	default_str("TZ", "timezone", pwd, lc_system, lc_user, "UTC");
+	default_str("EDITOR", "editor", pwd, lc_system, lc_user, "ex");
+	default_str("VISUAL", "visual", pwd, lc_system, lc_user, "vi");
+	default_str("PAGER", "pager", pwd, lc_system, lc_user, pager);
+	default_str("MANPAGER", "manpager", pwd, lc_system, lc_user, manpager);
+	default_str("MANXMLVIEWER", "manxmlviewer", pwd, lc_system, lc_user, xml_viewer);
+	default_str("WWWBROWSER", "www-browser", pwd, lc_system, lc_user, www_browser);
+	// The caller has already sanitized pw_shell and defaulted it to _PATH_BSHELL if necessary.
+	default_str("SHELL", "shell", pwd, lc_system, lc_user, pwd->pw_shell);
+}
