+#ifndef UTIL_LINUX_LOGIN_CONF_H
+#define UTIL_LINUX_LOGIN_CONF_H
+
+struct login_cap_t;	/* opaque */
+struct passwd;	/* forward */
+
+struct login_cap_t * loginconf_getsystem(const struct passwd * pwd);
+struct login_cap_t * loginconf_getuser(const struct passwd * pwd);
+void loginconf_close(struct login_cap_t * cap);
+
+int loginconf_get_hushlogin(const struct login_cap_t * lc_system, const struct login_cap_t * lc_user);
+void loginconf_set_environ(const struct passwd * pwd, struct login_cap_t * lc_system, struct login_cap_t * lc_user);
