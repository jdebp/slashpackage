+++ login-utils/login_cap.c	2026-10-16 19:37:54.482806431 +0100
@@ -0,0 +1,360 @@
+/*
+ *  login_cap.c -- workalike for the BSD login_cap(3) library
+ *
+ *  Copyright 2026 Jonathan de Boyne Pollard
+ *  This file is based on prior work by Jonathan de Boyne Pollard.
+ *
+ *  This file is free software; you can redistribute it and/or
+ *  modify it under the terms of the GNU Library General Public
+ *  License version 2 as published by the Free Software Foundation.
+ */
+/*
+ * This operates off the source text files.
+ * The original library operates off Berkeley DB files.
+ *
+ * We could operate off GDBM files likewise; but that would involve adding a cap_mkdb(1) clone.
+ */
+
+#include <errno.h>
+#include <pwd.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdbool.h>
+#include <string.h>
+#include <unistd.h>
+#include <ctype.h>
+
+#include "c.h"
+#include "closestream.h"
+#include "login_cap.h"
+
+#if !defined(LOGIN_DEFROOTCLASS)
+#define LOGIN_DEFROOTCLASS "root"
+#endif
+#if !defined(LOGIN_DEFCLASS)
+#define LOGIN_DEFCLASS "default"
+#endif
+#if !defined(LOGIN_MECLASS)
+#define LOGIN_MECLASS "me"
+#endif
+
+struct login_cap_t {
+	char * * list;
+	size_t size;
+	char * res;
+};
+
+static inline
+int
+append_char_to_string(
+	char ** ps,
+	char c
+) {
+	if (!ps)
+		return -EINVAL;
+	size_t l = strlen(*ps);
+	char * tmp = realloc(*ps, l + 2U);
+	if (!tmp)
+		return -ENOMEM;
+	*ps = tmp;
+	tmp[l++] = c;
+	tmp[l++] = '\0';
+	return 0;
+}
+
+static
+void
+clear(
+	struct login_cap_t * d
+) {
+	for (size_t n = 0; n < d->size; ++n) {
+		free(d->list[n]);
+		d->list[n] = NULL;
+	}
+	d->size = 0;
+	free(d->list); d->list = NULL;
+	free(d->res); d->res = NULL;
+}
+
+inline
+void
+split_capabilities(
+	struct login_cap_t * d,
+	const char * line
+) {
+	bool inside = false;
+	for (char c = *line++; c; c = *line++) {
+		if (':' == c) {
+			inside = false;
+		} else
+		if (inside || !isspace((unsigned char)c))
+		{
+			if (!inside) {
+				++d->size;
+				char ** n = (char **)realloc(d->list, sizeof(*d->list) * d->size);
+				if (!n)
+					return;
+				d->list = n;
+				d->list[d->size - 1] = strdup("");
+				inside = true;
+			}
+			append_char_to_string(&d->list[d->size - 1], c);
+		}
+	}
+}
+
+static inline
+bool
+matches(
+	struct login_cap_t * d,
+	const char * const name
+) {
+	bool r = false;
+	if (!d && d->size <= 0U) return r;
+	bool inside = false;
+	char * field = strdup("");
+	char * names = d->list[0U];
+	for (char c = *names++; ; c = *names++) {
+		if (!c || '|' == c) {
+			inside = false;
+			if (0 == strcmp(name, field)) {
+				r = true;
+				break;
+			}
+			if (!c)
+				break;
+		} else
+		if (inside || !isspace((unsigned char)c))
+		{
+			if (!inside) {
+				*field = '\0';
+				inside = true;
+			}
+			append_char_to_string(&field, c);
+		}
+	}
+	free(field);
+	return r;
+}
+
+static
+bool
+lookup_byfile(
+	struct login_cap_t * d,
+	FILE * file,
+	const char * name
+) {
+	bool r = false;
+	if (!file || !name) return r;
+	clear(d);
+	enum { BOL, COMMENT, COMMENT_ESCAPE, LEAD_SPACE, LINE, LINE_ESCAPE } state = BOL;
+	char * line = strdup("");
+	for (;;) {
+		const int c = getc(file);
+		if (EOF == c) return false;
+		switch (state) {
+			append:
+				append_char_to_string(&line, c);
+				break;
+			newline:
+				*line = '\0';
+				state = BOL;
+				break;
+			case BOL:
+				if ('\n' == c) 
+					goto newline;
+				else
+				if (isspace((unsigned char)c))
+					state = LEAD_SPACE;
+				else
+				if ('#' == c)
+					state = COMMENT;
+				else {
+					state = LINE;
+					goto append;
+				}
+				break;
+			case LEAD_SPACE:
+				if ('\n' == c) 
+					goto newline;
+				else
+				if (isspace((unsigned char)c))
+					break;
+				else
+				if ('#' == c)
+					state = COMMENT;
+				else {
+					state = LINE;
+					goto append;
+				}
+				break;
+			case COMMENT:
+				if ('\n' == c) 
+					goto newline;
+				else
+				if ('\\' == c)
+					state = COMMENT_ESCAPE;
+				break;
+			case COMMENT_ESCAPE:
+				state = COMMENT;
+				break;
+			case LINE:
+				if ('\n' == c) {
+					split_capabilities(d, line);
+					if (matches(d, name)) {
+						r = true;
+						goto out;
+					}
+					clear(d);
+					goto newline;
+				} else
+				if ('\\' == c)
+					state = LINE_ESCAPE;
+				else
+					goto append;
+				break;
+			case LINE_ESCAPE:
+				state = LINE;
+				if ('\n' != c) {
+					append_char_to_string(&line, '\\');
+					goto append;
+				}
+				break;
+		}
+	}
+out:
+	free(line);
+	return r;
+}
+
+static
+bool
+lookup_byname(
+	struct login_cap_t * d,
+	const char * filename,
+	const char * c
+) {
+	bool r = false;
+	if (!filename)
+		return r;
+	FILE * f = fopen(filename, "r");
+	if (!f)
+		return r;
+	r = lookup_byfile(d, f, c);
+	fclose(f);
+	return r;
+}
+
+struct login_cap_t *
+login_getsystemclass(
+	const struct passwd * pwd
+) {
+	const char * c = pwd && 0 == pwd->pw_uid ? LOGIN_DEFROOTCLASS : LOGIN_DEFCLASS;
+	struct login_cap_t * r = (struct login_cap_t *)calloc(1U, sizeof(struct login_cap_t));
+	if (r) {
+		if (!lookup_byname(r, "/etc/login.conf", c)) {
+			const int error = errno;
+			login_close(r);
+			errno = error;
+			return NULL;
+		}
+	}
+	return r;
+}
+
+struct login_cap_t *
+login_getuserclass(
+	const struct passwd * pwd
+) {
+	if (!pwd || !pwd->pw_dir || !*pwd->pw_dir) return NULL;
+	struct login_cap_t * r = (struct login_cap_t *)calloc(1U, sizeof(struct login_cap_t));
+	if (r) {
+		size_t l = strlen(pwd->pw_dir);
+		char * filename = malloc(l + sizeof "/.login_conf");
+		if (filename)
+			strcat(strcpy(filename, pwd->pw_dir), "/.login_conf");
+		if (!filename || !lookup_byname(r, filename, LOGIN_MECLASS)) {
+			const int error = errno;
+			login_close(r);
+			errno = error;
+			return NULL;
+		}
+	}
+	return r;
+}
+
+const char *
+login_getcapstr(
+	struct login_cap_t * d,
+	const char *cap,
+	const char *def,
+	const char *err
+) {
+	if (!d || !cap)
+		return err;
+	size_t caplen = strlen(cap);
+	for (size_t n = 1; n < d->size; ++n) {
+		if (0 != strncmp(d->list[n], cap, caplen))
+			continue;
+		char sep = d->list[n][caplen];
+		if ('@' == sep && !d->list[n][caplen + 1])
+			return def;
+		if ('=' == sep) {
+			const char * val = d->list[n] + caplen + 1;
+			free(d->res);
+			d->res = strdup(val);
+			size_t len = strlen(d->res);
+			for (char * q = d->res; *q; ++q) {
+				if ('\\' == *q && q[1]) {
+					switch (q[1]) {
+						case '0': 		q[1] = '\0'; break;
+						case 'b': case 'B':	q[1] = '\b'; break;
+						case 'r': case 'R':	q[1] = '\r'; break;
+						case 'c': case 'C':	q[1] = ':'; break;
+						case 'e': case 'E':	q[1] = '\x1b'; break;
+						case 't': case 'T':	q[1] = '\t'; break;
+						case 'n': case 'N':	q[1] = '\n'; break;
+						case 'f': case 'F':	q[1] = '\f'; break;
+						default:		break;  // Also handles backslash escaping itself.
+					}
+					memmove(q, q + 1, len - (q - d->res));	// includes the terminating NUL
+				} else
+				if ('^' == *q && q[1]) {
+					q[1] ^= 0x40;
+					memmove(q, q + 1, len - (q - d->res));	// includes the terminating NUL
+				}
+			}
+			return d->res;
+		}
+	}
+	return def;
+}
+
+int
+login_getcapbool(
+	const struct login_cap_t * d,
+	const char * cap,
+	int def
+) {
+	if (!d || !cap)
+		return def;
+	size_t len = strlen(cap);
+	for (size_t n = 0; n < d->size; ++n) {
+		if (0 != strncmp(d->list[n], cap, len))
+			continue;
+		char sep = d->list[n][len];
+		if (!sep)
+			return true;
+		if ('@' == sep && !d->list[n][len + 1])
+			return false;
+	}
+	return def;
+}
+
+void
+login_close(
+	struct login_cap_t * d
+) {
+	if (d) clear(d);
+	free(d);
+}
