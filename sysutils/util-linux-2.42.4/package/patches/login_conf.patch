+/*
+ *  login_cap.h -- workalike for the BSD login_cap(3) library
+ *
+ *  Copyright 2026 Jonathan de Boyne Pollard
+ *  This file is based on prior work by Jonathan de Boyne Pollard.
+ *
+ *  This file is free software; you can redistribute it and/or
+ *  modify it under the terms of the GNU Library General Public
+ *  License version 2 as published by the Free Software Foundation.
+ */
+#ifndef UTIL_LINUX_LOGIN_CAP_H
+#define UTIL_LINUX_LOGIN_CAP_H
+
+struct login_cap_t;	/* opaque */
+struct passwd;	/* forward */
+
+struct login_cap_t * login_getsystemclass(const struct passwd * pwd);
+struct login_cap_t * login_getuserclass(const struct passwd * pwd);
+const char * login_getcapstr(struct login_cap_t * d, const char *cap, const char *def, const char *err);
+int login_getcapbool(const struct login_cap_t * d, const char * cap, int def);
+void login_close(struct login_cap_t * cap);
+
+#endif /* UTIL_LINUX_LOGIN_CAP_H */
