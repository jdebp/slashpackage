#!/bin/sh -e
# See http://jdebp.uk./FGA/slashpackage.html
if test \! -d package
then
	echo "You are not in the right directory." 1>&2
	exit 100
fi

. ../../package_scripts.subr	# Use common slashpackage shell function library.

name='util-linux'
version='2.42.4'
short_version='2.42'
source_archive() {
	extension='.tar.xz'
	url='https://www.kernel.org/pub/linux/utils/'"${name}"'/'v"${short_version}"'/'"${name}"'-'"${version}${extension}"
	SHA256='fbd62a100ab7bb8746ba0661255c3c48185b1e9021507c624da01fbc696330ec'
	SIZE=''
}
buildtools=""

fetch_source

export CDPATH=

autoreconf_options=--force
uses_gnu_make
uses_gnu_autotools_no_install
check_buildtools
clone_source_to_build

# Rebuild.
if ! > /dev/null expr "${MAKEFLAGS}" : "--jobs" &&
   ! > /dev/null expr "${REDOFLAGS}" : "--jobs"
then
	calculate_make_cpus
fi
target="${PWD}"
(
	cd build
	if ! test -r autoreconf.done
	then
		auto_reconfigure && install -m 0444 /dev/null autoreconf.done
	fi
	test -r config.status || sh ./configure --prefix="${target}" --build="$(slashpackage_target)" --enable-fdformat --enable-line --enable-write --enable-pg --enable-newgrp --enable-vipw
	"${make}" ${cpus:+ -j "${cpus}"}
	install -d -m 0755 man
	ln -f -- *utils/*.[1-9] *-cmd/*.[1-9] man/
)

# Atomically update the release directories ./command, ./library, ./include, and so forth.
# The build and release directories need not be on the same disc volume.
# And the files released must not be potentially overwritable and truncatable by the compiler/linker during subsequent builds.
# But released files can be links to other released files, of course.
install -d -m 0755 command manual

# ##############################################################################
# Build all of the ...{new} files in ./command, ./config, ./manual, and ./library.
install_commands_0 ''
install_manuals_0 man ''
collapse_utf8_man_0

# ##############################################################################
# Rename the ...{new} files in ./command, ./config, ./manual, and ./library.
install_commands_1
install_manuals_1 '' ''
collapse_utf8_man_1
