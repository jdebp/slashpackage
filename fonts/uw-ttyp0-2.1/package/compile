#!/bin/sh -e
# See http://jdebp.uk./FGA/slashpackage.html
if test \! -d package
then
	echo "You are not in the right directory." 1>&2
	exit 100
fi

. ../../package_scripts.subr	# Use common slashpackage shell function library.

name='uw-ttyp0'
version='2.1'
source_archive() {
	extension='.tar.gz'
	url='https://people.mpi-inf.mpg.de/~uwe/misc/'"${name}/${name}-${version}${extension}"
	SHA256='-'
	SIZE='-'
}
buildtools=

fetch_or_checkout_source

export CDPATH=

uses_gnu_make
clone_source_to_build
check_buildtools

# Rebuild.
if ! > /dev/null expr "${MAKEFLAGS}" : "--jobs" &&
   ! > /dev/null expr "${REDOFLAGS}" : "--jobs"
then
	calculate_make_cpus
fi
(
	export PATH="${PATH:+${PATH}:}"/package/fonts/unscii/command
	if vtfontcvt=$(command -v vtfontcvt) && $vtfontcvt --version >/dev/null 2>&1
	then
		vtfontcvt=../package/tools/vtfontcvt-unscii
	fi
	cd build
	test -r Makefile || sh ./configure ${vtfontcvt:+--vtfontcvt=${vtfontcvt}}
	"${make}" ${cpus:+ -j "${cpus}"}
)

# Atomically update the release directories ./command, ./library, ./include, and so forth.
# The build and release directories need not be on the same disc volume.
# And the files released must not be potentially overwritable and truncatable by the compiler/linker during subsequent builds.
# But released files can be links to other released files, of course.
install -d -m 0755 command manual config config/fonts

# ##############################################################################
# Build all of the ...{new} files in ./command and ./manual.
install_commands_0 bin
install_manuals_0 man ''
collapse_utf8_man_0

# ##############################################################################
# Rename the ...{new} files in ./command and ./manual.
install_commands_1
install_manuals_1 '' ''
collapse_utf8_man_1

# ##############################################################################
# Build all of the ...{new} files in ./config.
install_fonts_0 'genconsfreebsdvt' .fnt

# ##############################################################################
# Rename the ...{new} directories and files in ./config.
install_fonts_1 .fnt
